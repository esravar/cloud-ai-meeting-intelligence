ENVIRONMENT=production
API_DOMAIN=api.esravar.com
CORS_ORIGINS=https://esravar.com,https://www.esravar.com,https://your-site.netlify.app

# Generate unique production secrets. Never commit the real .env file.
POSTGRES_PASSWORD=replace-with-url-safe-random-hex
APP_SECRET_KEY=replace-with-a-long-random-secret
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-compatible-key

OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=60

OPENAI_API_KEY=replace-with-your-openai-key
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

ACCESS_TOKEN_MINUTES=60
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=5
AGENT_HISTORY_TURNS=6

OTEL_SERVICE_NAME=meeting-intelligence-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
