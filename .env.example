APP_NAME=Cloud AI Meeting Intelligence
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-long-random-secret
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
ACCESS_TOKEN_MINUTES=60

OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=replace-for-audio-transcription
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

DATABASE_URL=postgresql+psycopg://meeting:meeting@localhost:5432/meeting_intelligence
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=work/uploads
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=5
AGENT_HISTORY_TURNS=6

# Prometheus metrics are exposed at /metrics. OTLP tracing is optional.
OTEL_SERVICE_NAME=meeting-intelligence-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Provider prices in USD per one million tokens; update when prices change.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
